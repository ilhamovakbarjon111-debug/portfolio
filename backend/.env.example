# Backend Environment Variables — namuna
# Bu faylni `.env` deb nusxa oling va o'z qiymatlaringizni qo'ying.

# Server porti (default: 3001)
PORT=3001

# Admin paroli — admin panelga kirish uchun
ADMIN_PASSWORD=change-this-strong-password

# PostgreSQL ulanish satri.
# Lokal:           postgresql://postgres:password@localhost:5432/portfolio
# Lokal SSL bilan: postgresql://postgres:password@localhost:5432/portfolio?sslmode=disable
# Neon:            postgresql://user:pass@xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio?sslmode=disable

# Frontend manzili (CORS). Bir nechta domen vergul bilan: ALLOWED_ORIGINS=http://localhost:5173,https://example.com
# Bo'sh qoldirilsa — barcha originlar ruxsat etiladi (development uchun ok, production uchun xavfsiz emas).
ALLOWED_ORIGINS=http://localhost:5173
